# Copie para .env.local e preencha com as SUAS chaves. Nunca commite .env.local.
# Sem as duas primeiras, o app roda em modo demonstração (dados no navegador).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: webhook do Stripe e exclusão de conta. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — use chaves de TESTE (sk_test_...) até o deploy
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preço único (one-time) do plano anual, criado no painel do Stripe
STRIPE_PRICE_ANNUAL=
